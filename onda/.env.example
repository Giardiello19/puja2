# ============================================================
# ONDA — variables de entorno
# Copia este archivo a ".env" y rellena lo que vayas a usar.
# La app FUNCIONA sin nada de esto (modo demo). Cada bloque que
# completes activa esa parte para que sea 100% real.
# ============================================================

# Puerto y URL pública (para webhooks y redirecciones de pago)
PORT=3000
# PUBLIC_URL=https://tu-dominio.com    # en local no hace falta

# Secreto para firmar las sesiones (CÁMBIALO en producción)
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria

# ------------------------------------------------------------
# VIDEO EN VIVO — LiveKit (open source, Apache-2.0)
# Gratis en https://cloud.livekit.io  ó  self-host: https://github.com/livekit/livekit
# Sin esto, el stream corre en "modo demo" (sin video real).
# ------------------------------------------------------------
# LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ------------------------------------------------------------
# PAGOS — Stripe   (https://dashboard.stripe.com/apikeys)
# ------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...     # al crear el webhook en el dashboard
# STRIPE_CURRENCY=mxn

# ------------------------------------------------------------
# PAGOS — Mercado Pago
# Credenciales en https://www.mercadopago.com.mx/developers
# ------------------------------------------------------------
# MP_ACCESS_TOKEN=APP_USR-...

# ------------------------------------------------------------
# Depósito DEMO: acredita saldo sin pasarela real (solo para
# probar el flujo de pujas/compras sin claves). NO usar en prod.
# ------------------------------------------------------------
DEMO_PAYMENTS=true
